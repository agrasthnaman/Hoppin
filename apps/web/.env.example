# Copy to apps/web/.env.local and fill in. Everything here ends up in the browser, so only public values belong here:
# never the service_role key or any other secret.

# Supabase project address and its public (anon) key: Dashboard > Project Settings > API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public). Empty turns the bot check off. See docs/turnstile.md.
VITE_TURNSTILE_SITE_KEY=
