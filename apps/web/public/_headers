# Security headers for every page and file (Cloudflare Pages reads this file at deploy time).

/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  # Enforced now: nobody can frame the app, plugins are off, and the page's base address and forms stay on our own site.
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  # Reported only for now (nothing is blocked): the full list of places the app may load from. Open the app with the
  # browser console open; when no violation is reported, move this line into the enforced header above.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://images.unsplash.com https://tiles.openfreemap.org; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://api.frankfurter.dev https://api.open-meteo.com https://geocoding-api.open-meteo.com https://photon.komoot.io https://tiles.openfreemap.org https://cdn.jsdelivr.net https://tessdata.projectnaptha.com blob: data:; frame-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests
