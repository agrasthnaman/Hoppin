{
  "name": "hoppin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "supabase"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p supabase --noEmit && tsc -p apps/web --noEmit",
    "demo": "npm run dev:demo -w apps/web",
    "dev": "npm run dev -w apps/web",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
